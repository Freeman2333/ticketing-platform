# Copy to .env and fill in real local values. .env is gitignored; this file is not.

# --- Postgres ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticketing

# Must match the three vars above - not re-derived automatically.
DATABASE_URL=postgresql://ticketing:change-me@localhost:5432/ticketing

# --- Redis ---
# Matches the `redis` service in docker-compose.yml - no password set there.
REDIS_URL=redis://localhost:6379

# --- RabbitMQ ---
RABBITMQ_USER=ticketing
RABBITMQ_PASSWORD=change-me

# Must match the two vars above - not re-derived automatically (same pattern
# as DATABASE_URL). Used by backend (producer) and notifications (consumer).
RABBITMQ_URL=amqp://ticketing:change-me@localhost:5672

# --- Notifications (Resend, step-5-notifications-plan.md) ---
# Free tier, no card required: https://resend.com. Without a verified custom
# domain, Resend only delivers to the email the account itself registered
# with (extraction-design.md §1) - a known, accepted limitation.
RESEND_API_KEY=change-me

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=ticketing
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET=event-posters

# --- Auth ---
# HS256 signing secret (backend-design.md §2/§7). Generate your own, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=change-me

# --- Frontend (bundled into client code, see integration-design.md §2) ---
# No trailing /api - Orval-generated paths already include it (they come
# straight from the OpenAPI spec, which reflects main.ts's setGlobalPrefix).
NX_PUBLIC_API_URL=http://localhost:3000

# --- Backend CORS (read server-side only, not bundled into client code) ---
# Where the shell/catalog dev server runs - allowed origin for REST CORS and
# the WebSocket gateway's handshake.
FRONTEND_ORIGIN=http://localhost:4200
