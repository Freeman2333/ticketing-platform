# Copy to .env and fill in real local values. .env is gitignored; this file is not.

# --- Postgres ---
POSTGRES_USER=ticketing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticketing

# Must match the three vars above - not re-derived automatically.
DATABASE_URL=postgresql://ticketing:change-me@localhost:5432/ticketing

# --- RabbitMQ ---
# Not wired into backend code yet (project-plan.md Step 0) - provisioned now
# per backend-design.md §10 to avoid a second infra bootstrap later.
RABBITMQ_USER=ticketing
RABBITMQ_PASSWORD=change-me

# --- MinIO ---
MINIO_ACCESS_KEY=ticketing
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET=event-posters

# --- Auth ---
# HS256 signing secret (backend-design.md §2/§7). Generate your own, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=change-me

# --- Frontend (bundled into client code, see integration-design.md §2) ---
NX_PUBLIC_API_URL=http://localhost:3000/api
