// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Each backend module owns its own schema (backend-design.md §3).
datasource db {
  provider = "postgresql"
  schemas  = ["auth", "events", "orders", "payments"]
}

enum Role {
  attendee
  organizer
  admin

  @@schema("auth")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")

  refreshTokens RefreshToken[]

  @@map("users")
  @@schema("auth")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
  @@schema("auth")
}

model Venue {
  id          String  @id @default(uuid())
  organizerId String  @map("organizer_id")
  name        String
  address     String
  imageUrl    String? @map("image_url")

  events Event[]

  @@map("venues")
  @@schema("events")
}

model Event {
  id          String   @id @default(uuid())
  venueId     String   @map("venue_id")
  title       String
  description String?
  startsAt    DateTime @map("starts_at")
  posterUrl   String?  @map("poster_url")

  venue     Venue      @relation(fields: [venueId], references: [id])
  seats     Seat[]
  seatTypes SeatType[]
  views     EventView[]

  @@map("events")
  @@schema("events")
}

enum SeatStatus {
  available
  held
  booked

  @@schema("events")
}

model SeatType {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  label   String
  price   Int

  event Event  @relation(fields: [eventId], references: [id])
  seats Seat[]

  @@unique([eventId, label])
  @@map("seat_types")
  @@schema("events")
}

model Seat {
  id         String     @id @default(uuid())
  eventId    String     @map("event_id")
  seatTypeId String     @map("seat_type_id")
  label      String
  status     SeatStatus @default(available)

  event    Event    @relation(fields: [eventId], references: [id])
  seatType SeatType @relation(fields: [seatTypeId], references: [id])

  @@index([eventId, status])
  @@map("seats")
  @@schema("events")
}

model EventView {
  id       String   @id @default(uuid())
  anonId   String?  @map("anon_id")
  userId   String?  @map("user_id")
  eventId  String   @map("event_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([anonId, eventId])
  @@unique([userId, eventId])
  @@index([userId, viewedAt])
  @@index([anonId, viewedAt])
  @@map("event_views")
  @@schema("events")
}

enum OrderStatus {
  draft
  reserved
  paid
  issued
  cancelled

  @@schema("orders")
}

model Order {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  eventId       String      @map("event_id")
  eventTitle    String      @map("event_title")
  eventStartsAt DateTime    @map("event_starts_at")
  status        OrderStatus @default(draft)
  reservedUntil DateTime?   @map("reserved_until")
  ticketsPdfUrl String?     @map("tickets_pdf_url")
  createdAt     DateTime    @default(now()) @map("created_at")

  items OrderItem[]

  @@index([userId])
  @@map("orders")
  @@schema("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String @map("order_id")
  seatId    String @map("seat_id")
  seatLabel String @map("seat_label")
  price     Int

  order  Order   @relation(fields: [orderId], references: [id])
  ticket Ticket?

  @@index([orderId])
  @@map("order_items")
  @@schema("orders")
}

model OrdersOutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt])
  @@map("outbox_events")
  @@schema("orders")
}

enum PaymentStatus {
  pending
  succeeded
  failed

  @@schema("payments")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  stripeSessionId String        @unique @map("stripe_session_id")
  amount          Int
  status          PaymentStatus @default(pending)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
  @@schema("payments")
}

model Ticket {
  id          String   @id @default(uuid())
  orderItemId String   @unique @map("order_item_id")
  issuedAt    DateTime @default(now()) @map("issued_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@map("tickets")
  @@schema("orders")
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String    @map("event_type")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt])
  @@map("outbox_events")
  @@schema("payments")
}
